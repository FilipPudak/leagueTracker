# Copy this file to .env and fill in your real values.
# .env is git-ignored and must never be committed.

# Google Sheets ID to use as the league database
SPREADSHEET_ID=your-spreadsheet-id-here

# Published URL of the backend Apps Script web app (frontend/Code.gs)
API_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# SWU league website scraped for player sync (optional)
SCRAPE_URL=https://stockholm.sw-unlimited.com/

# Shared secret between frontend (Script 2) and backend (Script 1). Must match in both.
# Used by the backend to reject requests from unknown callers.
API_SECRET=change-me-to-a-long-random-string
