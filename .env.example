# Local environment - DO NOT COMMIT (see .gitignore)

# Cloudflare account ID (required for wrangler D1 commands)
# Find it in your Cloudflare dashboard URL: https://dash.cloudflare.com/YOUR_ACCOUNT_ID/...
CLOUDFLARE_ACCOUNT_ID=

# Melee.gg API credentials (required for syncFromMelee)
# Get from: contact@melee.gg (organization staff access required)
MELEE_CLIENT_ID=
MELEE_CLIENT_SECRET=

# Allowed CORS origin for the Worker API
ALLOWED_ORIGIN=https://filippudak.github.io

# Note: D1 database binding and Worker config are in backend/wrangler.toml
# Frontend API_URL is hardcoded in docs/app/app.js
